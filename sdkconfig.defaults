# InertialSaber OS — sdkconfig overrides
# See docs/wiki/sdkconfig_overrides.md for rationale.

# FAT Long File Name Support (CRITICAL)
# Without LFN, profile.json (4-char extension) cannot be resolved
# and the system boots silently with zero profiles.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# FreeRTOS tick rate
CONFIG_FREERTOS_HZ=1000

# Main task stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# Partition table: partitions.csv (8 MB layout, flash size set in sdkconfig.defaults.esp32s3)
CONFIG_PARTITION_TABLE_CUSTOM=y
